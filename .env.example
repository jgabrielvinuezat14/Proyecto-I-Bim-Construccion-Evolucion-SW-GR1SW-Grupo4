# Copiar este archivo como .env (el .env NO se sube al repositorio).
# La contraseña debe tener al menos 8 caracteres e incluir mayúsculas,
# minúsculas, números y un símbolo; si no, SQL Server no arranca.
MSSQL_SA_PASSWORD=CambiarEstaClave#2026

# Variables que usará la aplicación web para conectarse.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=CafeteriaDB;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=CambiarEstaClave#2026

# Acceso del personal de cafetería (HU-10). No se guarda en la base de datos.
STAFF_ACCESS_CODE=CAFE-2026
STAFF_PASSWORD=CambiarClavePersonal#2026
